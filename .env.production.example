# ==============================================================================
# B2B ERP PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env on your EC2 instance or set as GitHub Secrets
# ==============================================================================

# AWS RDS PostgreSQL Configuration
RDS_ENDPOINT=your-rds-postgresql-endpoint.xxxxxx.us-east-1.rds.amazonaws.com
POSTGRES_DB=bread_erp_db
POSTGRES_USER=erp_admin
POSTGRES_PASSWORD=YourSecureProductionPassword123!

# AWS ElastiCache Redis Configuration
ELASTICACHE_HOST=your-elasticache-cluster.xxxxxx.use1.cache.amazonaws.com
ELASTICACHE_PORT=6379
ELASTICACHE_PASSWORD=
ELASTICACHE_SSL=false

# Security & JWT Configuration
JWT_SECRET=ReplaceWithAStrong64ByteHexadecimalSecretString0123456789abcdef
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000

# Cloudinary Integration (Media Storage)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Domain & Registry Configuration
DOMAIN_NAME=yourdomain.com
DOCKER_REGISTRY=ghcr.io
GH_REPO_OWNER=your-github-username-or-org
IMAGE_TAG=latest
